# 受控存储根目录（附件/原EML/隔离文件）
MAIL_ARCHIVE_HOME=/var/lib/mail-archive

# 留空=内存元数据后端；设置后=PostgreSQL
# MAIL_ARCHIVE_DSN=postgresql://mail:secret@127.0.0.1:5432/mailarchive

# 上传大小上限（字节），0=不限
MAIL_ARCHIVE_MAX_BYTES=52428800

# 摄取后自动重建会话图
MAIL_ARCHIVE_REBUILD_THREADS=true

# 测试用（仅 tests/test_postgres.py 读取）
# MAIL_TEST_DSN=postgresql://postgres@/mailarchive_test?host=/tmp/pgdata
